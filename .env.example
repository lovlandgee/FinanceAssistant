# Скопируйте в .env и запустите локально.
#
# cp .env.example .env
#
# GigaChat ключ авторизации (из developers.sber.ru)
GIGACHAT_CREDENTIALS=your_authorization_key_here

# SSL верификация для GigaChat API (default: согласие — оставить включенным)
# Установите значение false только для локальной отладки в сетях с проблемами сертификатов.
GIGACHAT_VERIFY_SSL_CERTS=true
